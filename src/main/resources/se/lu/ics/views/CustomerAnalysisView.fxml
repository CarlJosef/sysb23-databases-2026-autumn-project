<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:id="customerAnalysisOverlay"
    fx:controller="se.lu.ics.controllers.CustomerAnalysisController"
    styleClass="modal-overlay"
    visible="false"
    managed="false">

    <VBox spacing="16"
        styleClass="modal-panel"
        prefWidth="850"
        maxWidth="850">

        <HBox spacing="10"
            alignment="CENTER_LEFT">

            <VBox spacing="5">
                <Label text="Customer Analysis"
                    styleClass="modal-title"
                    fx:id="customerAnalysisTitleLabel" />

                <Label text="Orders and products for the selected customer."
                    styleClass="section-subtitle"
                    wrapText="true" />
            </VBox>
        </HBox>

        <TabPane fx:id="customerAnalysisTabPane"
            tabClosingPolicy="UNAVAILABLE"
            styleClass="marvix-tabs"
            prefHeight="340">

            <tabs>
                <Tab text="Customer Orders"
                    closable="false">

                    <content>
                        <TableView fx:id="customerOrdersTable"
                            prefHeight="300"
                            minHeight="300"
                            styleClass="marvix-table"
                            editable="false">

                            <columns>
                                <TableColumn fx:id="customerOrderIdColumn"
                                    text="ORDER ID"
                                    prefWidth="155"
                                    sortable="true" />

                                <TableColumn fx:id="customerOrderDateColumn"
                                    text="ORDER DATE"
                                    prefWidth="190"
                                    sortable="true" />

                                <TableColumn fx:id="customerOrderSubtotalColumn"
                                    text="SUBTOTAL"
                                    prefWidth="145"
                                    sortable="true" />

                                <TableColumn fx:id="customerOrderDiscountColumn"
                                    text="DISCOUNT"
                                    prefWidth="135"
                                    sortable="true" />

                                <TableColumn fx:id="customerOrderTotalColumn"
                                    text="ORDER TOTAL"
                                    prefWidth="170"
                                    sortable="true" />
                            </columns>

                            <placeholder>
                                <Label
                                    text="Data will appear after the SQL Server connection is configured"
                                    styleClass="table-placeholder" />
                            </placeholder>
                        </TableView>
                    </content>
                </Tab>

                <Tab text="Latest Order"
                    closable="false">

                    <content>
                        <VBox spacing="15"
                            styleClass="tab-content">

                            <HBox spacing="12"
                                alignment="CENTER_LEFT">

                                <Label text="Order ID"
                                    styleClass="field-caption"
                                    minWidth="125" />

                                <Label text="—"
                                    styleClass="field-value"
                                    fx:id="latestOrderIdLabel" />
                            </HBox>

                            <HBox spacing="12"
                                alignment="CENTER_LEFT">

                                <Label text="Order Date"
                                    styleClass="field-caption"
                                    minWidth="125" />

                                <Label text="—"
                                    styleClass="field-value"
                                    fx:id="latestOrderDateLabel" />
                            </HBox>

                            <HBox spacing="12"
                                alignment="CENTER_LEFT">

                                <Label text="Order Total"
                                    styleClass="field-caption"
                                    minWidth="125" />

                                <Label text="—"
                                    styleClass="field-value"
                                    fx:id="latestOrderTotalLabel" />
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <Tab text="Ordered Products"
                    closable="false">

                    <content>
                        <TableView fx:id="customerOrderedProductsTable"
                            prefHeight="300"
                            minHeight="300"
                            styleClass="marvix-table"
                            editable="false">

                            <columns>
                                <TableColumn fx:id="customerProductIdColumn"
                                    text="PRODUCT ID"
                                    prefWidth="175"
                                    sortable="true" />

                                <TableColumn fx:id="customerProductNameColumn"
                                    text="PRODUCT NAME"
                                    prefWidth="360"
                                    sortable="true" />

                                <TableColumn fx:id="customerProductPriceColumn"
                                    text="PRICE"
                                    prefWidth="190"
                                    sortable="true" />
                            </columns>

                            <placeholder>
                                <Label
                                    text="Data will appear after the SQL Server connection is configured"
                                    styleClass="table-placeholder" />
                            </placeholder>
                        </TableView>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

        <HBox spacing="0"
            alignment="CENTER_RIGHT">

            <Button text="Close"
                onAction="#handleCloseCustomerAnalysis"
                styleClass="button-outline"
                fx:id="closeCustomerAnalysisButton" />
        </HBox>

    </VBox>

</StackPane>
