<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="se.lu.ics.controllers.CustomerController">

    <!-- Customer main view -->
    <ScrollPane fx:id="customersScreen"
        fitToWidth="true"
        styleClass="page-scroll"
        hbarPolicy="NEVER">

        <content>
            <VBox spacing="18"
                styleClass="page-body"
                fillWidth="true"
                maxWidth="Infinity">

                <HBox spacing="14"
                    styleClass="page-title-row"
                    alignment="CENTER_LEFT">

                    <VBox spacing="4">
                        <Label text="Customers"
                            styleClass="page-title" />

                        <Label text="Manage registered customers and loyalty levels"
                            styleClass="page-subtitle" />
                    </VBox>
                </HBox>

                <HBox spacing="10"
                    styleClass="toolbar-card"
                    alignment="CENTER_LEFT">

                    <TextField fx:id="customerSearchField"
                        promptText="Search by Customer ID"
                        prefWidth="275"
                        styleClass="input-search" />

                    <Button text="Search"
                        onAction="#handleSearchCustomer"
                        styleClass="button-secondary" />

                    <Button text="Customer Analysis"
                        onAction="#handleOpenCustomerAnalysis"
                        styleClass="button-outline" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button text="+  New Customer"
                        onAction="#handleNewCustomer"
                        styleClass="button-primary" />
                </HBox>

                <VBox spacing="0"
                    styleClass="panel-card">

                    <TableView fx:id="customersTable"
                        prefHeight="430"
                        minHeight="430"
                        styleClass="marvix-table"
                        editable="false">

                        <columns>
                            <TableColumn fx:id="customerIdColumn"
                                text="CUSTOMER ID"
                                prefWidth="110"
                                sortable="true" />

                            <TableColumn fx:id="customerNameColumn"
                                text="CUSTOMER NAME"
                                prefWidth="175"
                                sortable="true" />

                            <TableColumn fx:id="customerAddressColumn"
                                text="ADDRESS"
                                prefWidth="220"
                                sortable="true" />

                            <TableColumn fx:id="customerEmailColumn"
                                text="EMAIL"
                                prefWidth="245"
                                sortable="true" />

                            <TableColumn fx:id="customerLoyaltyColumn"
                                text="LOYALTY LEVEL"
                                prefWidth="120"
                                sortable="true" />

                            <TableColumn fx:id="customerDiscountColumn"
                                text="DISCOUNT"
                                prefWidth="95"
                                sortable="true" />

                            <TableColumn fx:id="customerActionsColumn"
                                text="ACTIONS"
                                prefWidth="185"
                                sortable="false" />
                        </columns>

                        <placeholder>
                            <Label text="No customers found."
                                styleClass="table-placeholder" />
                        </placeholder>
                    </TableView>

                    <HBox spacing="10"
                        styleClass="table-footer"
                        alignment="CENTER_LEFT">

                        <Label text="Customer records"
                            styleClass="footer-hint" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button text="‹"
                            styleClass="pager-button"
                            disable="true" />

                        <Button text="1"
                            styleClass="pager-button"
                            disable="true" />

                        <Button text="›"
                            styleClass="pager-button"
                            disable="true" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Separate customer subviews with their own controllers. -->
    <fx:include fx:id="customerForm" source="CustomerFormView.fxml" />
    <fx:include fx:id="customerAnalysis" source="CustomerAnalysisView.fxml" />

</StackPane>
