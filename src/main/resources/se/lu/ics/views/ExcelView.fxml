<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="se.lu.ics.controllers.ExcelController"
    fitToWidth="true"
    styleClass="page-scroll"
    hbarPolicy="NEVER">

    <content>
        <VBox spacing="18"
            styleClass="page-body"
            fillWidth="true"
            maxWidth="Infinity">

            <!-- Page header -->
            <HBox spacing="14"
                styleClass="page-title-row"
                alignment="CENTER_LEFT">

                <VBox spacing="4">
                    <Label text="Excel"
                        styleClass="page-title" />

                    <Label text="Open the prepared Microsoft Excel workbook for Marvix database data"
                        styleClass="page-subtitle" />
                </VBox>
            </HBox>

            <!-- Excel integration banner -->
            <HBox spacing="15"
                styleClass="excel-banner"
                alignment="CENTER_LEFT">

                <Label text="X"
                    styleClass="excel-icon"
                    alignment="CENTER"
                    minWidth="52"
                    minHeight="52" />

                <VBox spacing="5">
                    <Label text="Marvix Excel Integration"
                        styleClass="section-title" />

                    <Label
                        text="Open the prepared workbook containing Customers, Orders and Products data retrieved from SQL Server."
                        styleClass="section-subtitle"
                        wrapText="true" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button text="Open Excel File"
                    onAction="#handleOpenExcelFile"
                    styleClass="button-primary" />
            </HBox>

            <!-- Workbook datasets -->
            <HBox spacing="16">

                <!-- Customers dataset -->
                <VBox spacing="11"
                    styleClass="dataset-card"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity">

                    <HBox spacing="10"
                        alignment="CENTER_LEFT">

                        <Label text="♧"
                            styleClass="dataset-icon" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Dataset"
                            styleClass="record-tag" />
                    </HBox>

                    <Label text="Customers"
                        styleClass="section-title" />

                    <Label text="Customer records, email addresses and loyalty levels"
                        styleClass="section-subtitle"
                        wrapText="true" />

                    <Separator />

                    <HBox spacing="8"
                        alignment="CENTER_LEFT">

                        <Label text="Excel sheet: Customers"
                            styleClass="footer-hint" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Read-only"
                            styleClass="footer-hint" />
                    </HBox>
                </VBox>

                <!-- Orders dataset -->
                <VBox spacing="11"
                    styleClass="dataset-card"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity">

                    <HBox spacing="10"
                        alignment="CENTER_LEFT">

                        <Label text="▤"
                            styleClass="dataset-icon" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Dataset"
                            styleClass="record-tag" />
                    </HBox>

                    <Label text="Orders"
                        styleClass="section-title" />

                    <Label text="Order headers, dates and customer references"
                        styleClass="section-subtitle"
                        wrapText="true" />

                    <Separator />

                    <HBox spacing="8"
                        alignment="CENTER_LEFT">

                        <Label text="Excel sheet: Orders"
                            styleClass="footer-hint" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Read-only"
                            styleClass="footer-hint" />
                    </HBox>
                </VBox>

                <!-- Products dataset -->
                <VBox spacing="11"
                    styleClass="dataset-card"
                    HBox.hgrow="ALWAYS"
                    maxWidth="Infinity">

                    <HBox spacing="10"
                        alignment="CENTER_LEFT">

                        <Label text="⬡"
                            styleClass="dataset-icon" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Dataset"
                            styleClass="record-tag" />
                    </HBox>

                    <Label text="Products"
                        styleClass="section-title" />

                    <Label text="Product catalogue and current prices"
                        styleClass="section-subtitle"
                        wrapText="true" />

                    <Separator />

                    <HBox spacing="8"
                        alignment="CENTER_LEFT">

                        <Label text="Excel sheet: Products"
                            styleClass="footer-hint" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label text="Read-only"
                            styleClass="footer-hint" />
                    </HBox>
                </VBox>
            </HBox>

            <!-- Excel database connection information -->
            <VBox spacing="14"
                styleClass="panel-card">

                <HBox spacing="12"
                    styleClass="section-header"
                    alignment="CENTER_LEFT">

                    <VBox spacing="4">
                        <Label text="Connection Details"
                            styleClass="section-title" />

                        <Label text="Workbook database access configuration"
                            styleClass="section-subtitle" />
                    </VBox>
                </HBox>

                <HBox spacing="22">

                    <VBox spacing="8"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                        <Label text="CONNECTION TYPE"
                            styleClass="field-caption" />

                        <Label text="Read-only"
                            styleClass="field-value" />
                    </VBox>

                    <VBox spacing="8"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                        <Label text="DATABASE ACCOUNT"
                            styleClass="field-caption" />

                        <Label text="excel_reader"
                            styleClass="field-value" />
                    </VBox>

                    <VBox spacing="8"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                        <Label text="DATABASE SERVER"
                            styleClass="field-caption" />

                        <Label text="Microsoft SQL Server"
                            styleClass="field-value" />
                    </VBox>

                    <VBox spacing="8"
                        HBox.hgrow="ALWAYS"
                        maxWidth="Infinity">

                        <Label text="DATABASE"
                            styleClass="field-caption" />

                        <Label text="Marvix"
                            styleClass="field-value" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                    spacing="10"
                    styleClass="info-notice">

                    <Label text="Data access notice"
                        styleClass="notice-label" />

                    <Label
                        text="The Excel login is read-only. No database credentials are displayed in the application."
                        styleClass="notice-text"
                        wrapText="true" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
